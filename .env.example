# Marketing Radar — copy to .env and fill in. Never commit .env.
# All keys live with the parent dashboard process; the library reads them via python-dotenv.

# Shared Firebase project (same project as the overlord / parent dashboard)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=          # path to service-account JSON; leave empty to use ADC

# Where the parent stored the questionnaire. {userId} is substituted at runtime.
CONTEXT_PATH=users/{userId}/context

# ScrapeCreators — 100 free credits, never expire. 1 credit ≈ 1 request.
SCRAPECREATORS_API_KEY=

# Gemini free tier (Google AI Studio). No Anthropic key anywhere in this module.
GEMINI_API_KEY=
# Optional JSON override of the model ladder, e.g.
# [{"ids":["gemini-3-flash"],"quality":"high","daily_cap":1500}, ...]
GEMINI_LADDER_JSON=

# Optional — free YouTube Data API v3 (10k units/day). Skipped when empty.
YOUTUBE_API_KEY=

# v1 is single-user; the parent injects the real uid.
MARKETING_USER_ID=

# Set to 1 to force the in-memory backend + recorded fixtures (no network, no credits).
MARKETING_RADAR_OFFLINE=0
