# Marketing Radar — copy to .env and fill in. Never commit .env.
# All keys live with the parent dashboard process; the library reads them via python-dotenv.

# Shared Firebase project (same project as the overlord / parent dashboard)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=          # path to service-account JSON; leave empty to use ADC

# Where the parent stored the questionnaire. {userId} is substituted at runtime.
CONTEXT_PATH=users/{userId}/context

# ScrapeCreators — 100 free credits, never expire. 1 credit ≈ 1 request.
SCRAPECREATORS_API_KEY=

# Gemini free tier (Google AI Studio). No Anthropic key anywhere in this module.
GEMINI_API_KEY=
# Optional JSON override of the model ladder, e.g.
# [{"ids":["gemini-3-flash"],"quality":"high","daily_cap":1500}, ...]
GEMINI_LADDER_JSON=

# Optional — free YouTube Data API v3 (10k units/day). Skipped when empty.
YOUTUBE_API_KEY=

# v1 is single-user. Empty → the dashboard uses BUSINESS_ID as the marketing user id (plan 0005).
MARKETING_USER_ID=

# Set to 1 to force the in-memory backend + recorded fixtures (no network, no credits).
MARKETING_RADAR_OFFLINE=0

# ============================================================
# Voice AI Receptionist (plans/voice-receptionist/vr_plan.md §14)
# Server-only secrets: never import these in a client bundle (R3).
# ============================================================
PUBLIC_BASE_URL=                    # exact public origin Twilio calls (tunnel or Vercel). Signature validation depends on it
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                  # server only
TWILIO_PHONE_NUMBER=                # the AU mobile number
WS_TOKEN_SECRET=                    # HMAC secret for the WebSocket token (§6.3)
GROQ_API_KEY=
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY is shared with the marketing agent above (free tier, V4)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
BUSINESS_ID=                        # single tenant; still on every document
# FIREBASE_PROJECT_ID is shared with the marketing agent above
FIREBASE_SA_JSON=                   # base64 service-account JSON. Server only
FIRESTORE_EMULATOR_HOST=            # dev/test only. Must NOT be set in Vercel
GOOGLE_CALENDAR_ID=                 # owner's calendar, shared to the service account
GOOGLE_SA_JSON=                     # base64
EMAIL_PROVIDER=gmail                # gmail | resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
SESSION_SINK=firestore              # firestore | local | emulator (§12.3); the simulator forces local.
                                    # local = zero keys needed: dashboard + /sim + marketing fixtures all run offline
ENABLE_SIM=0                        # /sim refuses to mount unless 1
TZ_BUSINESS=Australia/Melbourne

# ============================================================
# Dashboard / overlord (plans/0005-dashboard-wiring.md). Numbers live in config/dashboard.yaml.
# ============================================================
BUSINESS_DATASET=uncle_tony         # folder under data/business used by the local reader + scripts/seed_business.py
MARKETING_SCHEDULER=0               # 1 only on a long-running host (uvicorn). Vercel uses `crons` → /api/jobs/* instead
CRON_SECRET=                        # Vercel sets `Authorization: Bearer $CRON_SECRET` on cron requests; required on Vercel
